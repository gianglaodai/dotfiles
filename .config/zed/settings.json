{
  "agent": {
    "default_model": {
      "provider": "google",
      "model": "gemini-3-pro-preview",
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "base_keymap": "JetBrains",
  "tab_bar": {
    "show": true,
  },

  "vim_mode": true,
  "ui_font_size": 20,
  "buffer_font_size": 20,
  "theme": {
    "mode": "system",
    "light": "Gruvbox Light",
    "dark": "Gruvbox Dark",
  },
  "ui_font_family": "Neucha",
  "buffer_font_family": "ComicShannsMono Nerd Font",
  "autosave": "on_window_change",
  "formatter": "prettier",
  "always_treat_brackets_as_autoclosed": true,
  "enable_language_server": true,
  "languages": {
    "JavaScript": {
      "formatter": {
        "external": {
          "command": "bun",
          "arguments": ["prettier", "--stdin-filepath", "{buffer_path}"],
        },
      },
    },
    "HTML": {
      "formatter": {
        "external": {
          "command": "bun",
          "arguments": ["prettier", "--stdin-filepath", "{buffer_path}"],
        },
      },
    },
    "JSON": {
      "formatter": {
        "external": {
          "command": "bun",
          "arguments": ["prettier", "--stdin-filepath", "{buffer_path}"],
        },
      },
    },
    "YAML": {
      "formatter": {
        "external": {
          "command": "bun",
          "arguments": ["prettier", "--stdin-filepath", "{buffer_path}"],
        },
      },
    },
    "TypeScript": {
      "formatter": {
        "external": {
          "command": "bun",
          "arguments": ["prettier", "--stdin-filepath", "{buffer_path}"],
        },
      },
    },
  },
}
